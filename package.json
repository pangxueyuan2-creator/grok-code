{
  "name": "grok-code",
  "version": "0.1.0-dev",
  "private": true,
  "description": "ForgePilot: a safer multi-provider coding-agent workbench built around Grok Build compatibility.",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint packages/core/src packages/runtime/src",
    "format": "biome format --write .",
    "package": "node scripts/package.mjs",
    "cli": "pnpm --filter @grok-code/cli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  }
}
